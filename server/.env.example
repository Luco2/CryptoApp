PORT=3001

# Anthropic (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your_key

# Alpaca (get from https://app.alpaca.markets)
ALPACA_KEY=your_alpaca_key
ALPACA_SECRET=your_alpaca_secret
ALPACA_PAPER=true

# Coinbase Advanced Trade (get from https://www.coinbase.com/settings/api)
COINBASE_KEY=organizations/.../apiKeys/...
COINBASE_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
COINBASE_PAPER=true

# Plaid (get from dashboard.plaid.com → sandbox keys)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
